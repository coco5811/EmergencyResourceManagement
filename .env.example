# Copy this file to .env and enter your local development credentials.
# Never commit your real .env file.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=emergency_resource_db
DB_CONNECT_TIMEOUT=5

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=emergency_resource_logs
MONGO_COLLECTION=incident_events
